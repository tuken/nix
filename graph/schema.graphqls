# GraphQL schema example
#
# https://gqlgen.com/getting-started/

type Org {
  id: ID!
  name: String!
  postalCode: String!
  address: String!
  note: String!
}

type Role {
  id: ID!
  name: String!
  description: String
}

type CropItem {
  id: ID!
  name: String!
  sortOrder: Int!
}

type CropVariety {
  id: ID!
  name: String!
  sortOrder: Int!
  item: CropItem!
}

type weatherCode {
  code: Int!
  japanese: String!
}

type Forecast {
  time: String!
  temperatureMax: Float!
  temperatureMin: Float!
  precipitationSum: Float!
  weatherCode: Int!
}

input CreateOrgInput {
  name: String!
  postalCode: String!
  address: String!
  note: String!
}

type Query {
  orgs: [Org!]!
  roles: [Role!]!
  cropItems: [CropItem!]!
  cropVarieties(itemID: ID!): [CropVariety!]!
  weatherCodes: [weatherCode!]!
  forecasts(latitude: Float!, longitude: Float!, days: Int!): [Forecast!]!
}

type Mutation {
  createOrg(input: CreateOrgInput!): Org!
}
