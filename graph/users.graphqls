type User {
  id: ID!
  org: Org!
  parent: User
  role: Role!
  email: String!
  password: String!
  farmName: String
  firstName: String!
  lastName: String!
  postalCode: String!
  address: String!
  gender: String!
  birthday: Date!
  note: String!
  lastLoginAt: Time
  createdAt: Time!
  fields: [Field!]
}

input CreateUserInput {
  parentID: Int
  roleID: Int!
  email: String!
  password: String!
  farmName: String
  firstName: String!
  lastName: String!
  postalCode: String!
  address: String!
  gender: String!
  birthday: Date!
  note: String!
  fieldIDs: [ID!]!
}

input UpdateUserInput {
  email: String
  password: String
  farmName: String
  firstName: String
  lastName: String
  postalCode: String
  address: String
  gender: String
  birthday: Date
  note: String
  fieldIDs: [ID!]
}

extend type Query {
  getUser(id: ID!): User
  listUsers: [User!]!
  findUsers(roleID: ID, contains: String): [User!]!
}

extend type Mutation {
  createUser(input: CreateUserInput!): User!
  updateUser(id: ID!, input: UpdateUserInput!): User!
  deleteUser(id: ID!): User
}
